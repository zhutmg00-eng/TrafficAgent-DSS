# ============================================================================
# TrafficAgent-DSS 环境变量样例
# 使用方法：复制本文件为 .env，填入真实值。
# .env 已被 .gitignore 忽略，不会进入版本库；请勿把密钥写进任何受控文件。
# ============================================================================

# ---------------------------------------------------------------------------
# 大语言模型（OpenAI 兼容协议）
# 留空 LLM_API_KEY 时，系统自动降级为确定性规则模板推理，
# 并在 API 响应与决策简报中如实标注 reasoning_mode，不会伪造结论。
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

# 可选：自定义 OpenAI 兼容端点（留空则使用 https://api.openai.com/v1）
# 示例：
#   DeepSeek    https://api.deepseek.com/v1
#   通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi        https://api.moonshot.cn/v1
#   百度千帆     https://qianfan.baidubce.com/v2   （模型如 ernie-4.5-turbo-128k）
# LLM_BASE_URL=

# ---------------------------------------------------------------------------
# 百度地图开放平台（LBS 能力底座：真实路网 / 实时路况 / 驾车路径规划）
# 1. 在 https://lbs.baidu.com 注册并完成实名认证；
# 2. 控制台「应用管理 → 创建应用」→ 类型选「浏览器端」，Referer 白名单填
#    http://127.0.0.1:8000/* 与 http://localhost:8000/*；
# 3. 将生成的 AK 填到下方（浏览器端 AK 属公开凭据，靠白名单防盗用）。
# 同一 AK 需同时开通「Web端地图 (JS API GL)」与「驾车路径规划」服务配额。
# ---------------------------------------------------------------------------
BAIDU_MAP_AK=
# 地图默认中心点（BD-09 经纬度，默认为北京学院南路-交大东路走廊一带）
BAIDU_MAP_CENTER_LNG=116.337
BAIDU_MAP_CENTER_LAT=39.965

# ---------------------------------------------------------------------------
# SUMO 微观仿真环境
# 若 SUMO 未加入系统 PATH，请在此指定安装根目录。
# Windows 示例：C:\Program Files (x86)\Eclipse\Sumo
# Linux/macOS 示例：/usr/share/sumo
# ---------------------------------------------------------------------------
# SUMO_HOME=
