# ============================================================================
# TrafficAgent-DSS 环境变量样例
# 使用方法：复制本文件为 .env，填入真实值。
# .env 已被 .gitignore 忽略，不会进入版本库；请勿把密钥写进任何受控文件。
# ============================================================================

# ---------------------------------------------------------------------------
# 大语言模型（OpenAI 兼容协议）
# 留空 LLM_API_KEY 时，系统自动降级为确定性规则模板推理，
# 并在 API 响应与决策简报中如实标注 reasoning_mode，不会伪造结论。
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

# 可选：自定义 OpenAI 兼容端点（留空则使用 https://api.openai.com/v1）
# 示例：
#   DeepSeek    https://api.deepseek.com/v1
#   通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi        https://api.moonshot.cn/v1
# LLM_BASE_URL=

# ---------------------------------------------------------------------------
# SUMO 微观仿真环境
# 若 SUMO 未加入系统 PATH，请在此指定安装根目录。
# Windows 示例：C:\Program Files (x86)\Eclipse\Sumo
# Linux/macOS 示例：/usr/share/sumo
# ---------------------------------------------------------------------------
# SUMO_HOME=
