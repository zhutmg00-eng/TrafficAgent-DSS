# ============================================================================
# TrafficAgent-DSS 环境变量样例
# 使用方法：复制本文件为 .env，填入真实值。
# .env 已被 .gitignore 忽略，不会进入版本库；请勿把密钥写进任何受控文件。
# ============================================================================

# ---------------------------------------------------------------------------
# 大语言模型（OpenAI 兼容协议）
# 留空 LLM_API_KEY 时，系统自动降级为确定性规则模板推理，
# 并在 API 响应与决策简报中如实标注 reasoning_mode，不会伪造结论。
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

# 可选：自定义 OpenAI 兼容端点（留空则使用 https://api.openai.com/v1）
# 示例：
#   DeepSeek    https://api.deepseek.com/v1
#   通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi        https://api.moonshot.cn/v1
#   百度千帆     https://qianfan.baidubce.com/v2   （模型如 ernie-4.5-turbo-128k）
# LLM_BASE_URL=

# ---------------------------------------------------------------------------
# 百度地图开放平台（LBS 能力底座：真实路网 / 实时路况 / 驾车路径规划）
#
# 申请步骤（约 5 分钟）：
# 1. 打开 https://lbs.baidu.com → 右上角「登录」→ 用百度账号登录；
# 2. 首次使用需完成「开发者认证」（个人认证即可，选「个人开发者」）；
# 3. 控制台 → 「应用管理」→「创建应用」：
#      · 应用名称：随意，如 traffic-agent-dss
#      · 应用类型：**浏览器端**（必须，否则前端 JS API 无法加载）
#      · Referer 白名单：把本机实际访问地址都填上（每行一条），例如
#            127.0.0.1:8501
#            localhost:8501
#            127.0.0.1:8000
#            localhost:8000
#        ※ 端口必须与你实际启动时用的 --port 一致，否则百度侧会报
#          "APP Referer 校验失败 (211)"。本项目默认端口 8501（见 app.py 的
#          DEFAULT_DASHBOARD_PORT）；若你改用别的端口，这里也要同步加。
# 4. 创建后复制生成的 **AK** 填到下方 BAIDU_MAP_AK。
#    同一 AK 默认包含「Web 端地图 (JS API GL)」；若要用驾车路径规划，
#    在控制台「我的服务」中确认已勾选「驾车路线规划」配额。
#
# 安全说明：
#   · 浏览器端 AK 属于公开凭据，靠上面的 Referer 白名单防盗用——不要开启
#     「服务端」类型，也不要把 AK 写进任何受控文件（.env 已被 .gitignore 忽略）。
#   · 未配置 AK 时，大屏会显式显示「百度地图 LBS 未接入」并给出配置入口，
#     绝不会退化成伪造的地图或编造的路况数据。
# ---------------------------------------------------------------------------
BAIDU_MAP_AK=
# 地图默认中心点（BD-09 经纬度，默认为北京学院南路-交大东路走廊一带）
BAIDU_MAP_CENTER_LNG=116.337
BAIDU_MAP_CENTER_LAT=39.965

# ---------------------------------------------------------------------------
# SUMO 微观仿真环境
# 若 SUMO 未加入系统 PATH，请在此指定安装根目录。
# Windows 示例：C:\Program Files (x86)\Eclipse\Sumo
# Linux/macOS 示例：/usr/share/sumo
# ---------------------------------------------------------------------------
# SUMO_HOME=
